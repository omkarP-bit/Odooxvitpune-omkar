generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  SKIPPED
}

enum RuleType {
  AMOUNT_THRESHOLD
  CATEGORY
  DEPARTMENT
}

enum SlaAction {
  ESCALATE
  AUTO_REJECT
  REASSIGN
  NOTIFY
}

model User {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @default(uuid()) @map("public_id")
  email       String   @unique
  name        String
  role        Role     @default(EMPLOYEE)
  companyId   String   @map("company_id")
  companyName String?  @map("company_name")
  managerId   BigInt?  @map("manager_id")
  currency    String   @default("USD") @map("currency")
  createdAt   DateTime @default(now()) @map("created_at")

  manager   User?    @relation("ManagerEmployee", fields: [managerId], references: [id])
  reports   User[]   @relation("ManagerEmployee")
  expenses  Expense[]
  approvals Approval[]

  @@index([companyId])
  @@map("users")
}

model Expense {
  id               BigInt        @id @default(autoincrement())
  publicId         String        @unique @default(uuid()) @map("public_id")
  userId           BigInt        @map("user_id")
  amountOriginal   Decimal       @map("amount_original") @db.Decimal(15, 2)
  currencyOriginal String        @map("currency_original") @db.VarChar(3)
  amountConverted  Decimal?      @map("amount_converted") @db.Decimal(15, 2)
  currencyCompany  String?       @map("currency_company") @db.VarChar(3)
  exchangeRate     Decimal?      @map("exchange_rate") @db.Decimal(15, 6)
  category         String
  vendor           String?
  description      String?
  receiptUrl       String?       @map("receipt_url")
  status           ExpenseStatus @default(PENDING)
  expenseDate      DateTime      @map("expense_date") @db.Date
  createdAt        DateTime      @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  approvals Approval[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("expenses")
}

model Approval {
  id          BigInt         @id @default(autoincrement())
  publicId    String         @unique @default(uuid()) @map("public_id")
  expenseId   BigInt         @map("expense_id")
  approverId  BigInt         @map("approver_id")
  status      ApprovalStatus @default(PENDING)
  stepOrder   Int            @map("step_order")
  comments    String?
  decidedAt   DateTime?      @map("decided_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  slaDeadline DateTime?      @map("sla_deadline")

  expense  Expense @relation(fields: [expenseId], references: [id])
  approver User    @relation(fields: [approverId], references: [id])

  @@index([expenseId])
  @@index([approverId])
  @@index([status])
  @@map("approvals")
}

model Rule {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @default(uuid()) @map("public_id")
  companyId String   @map("company_id")
  ruleType  RuleType @map("rule_type")
  condition Json
  action    Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("rules")
}

model SlaRule {
  id           BigInt    @id @default(autoincrement())
  companyId    String    @map("company_id")
  timeoutHours Int       @map("timeout_hours")
  action       SlaAction
  isActive     Boolean   @default(true) @map("is_active")

  @@index([companyId])
  @@map("sla_rules")
}

model ExchangeRateCache {
  id         BigInt   @id @default(autoincrement())
  baseCurrency  String   @map("base_currency") @db.VarChar(3)
  rates      Json
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@index([baseCurrency])
  @@map("exchange_rate_cache")
}
